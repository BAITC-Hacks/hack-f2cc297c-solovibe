# Run pnpm env:init to create .env and random local database/session secrets.
# Development process connects through loopback; Compose uses the internal db service.
POSTGRES_DB=solovibe
POSTGRES_USER=solovibe
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
DATABASE_URL=
APP_PORT=3000
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Composio Platform project key; users authorize their own app accounts through Connect Links.
COMPOSIO_API_KEY=
# Sandbox Checkout only: use sk_test_... (live keys are rejected).

# Private R2 storage. Leave endpoint blank to derive it from the account ID.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
